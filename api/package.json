{
  "name": "recommendations-api",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc && cp -r src/protos dist/protos",
    "start": "node dist/server.js",
    "test": "jest",
    "test:unit": "jest --testMatch \"**/*.spec.ts\" --testPathIgnorePatterns=__tests__/helpers",
    "test:integration": "RUN_INTEGRATION_TESTS=true jest --testMatch \"**/*.test.ts\" --testPathIgnorePatterns=__tests__/helpers",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "typeorm:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "npm run typeorm:create -- migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "lint": "eslint \"./**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.2.0",
    "@sentry/node": "^10.29.0",
    "@sentry/profiling-node": "^10.29.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "pg": "^8.16.3",
    "protobufjs": "^7.5.4",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.1.14",
    "supertest": "^7.1.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.27",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.26",
    "@types/redis": "^4.0.11",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "eslint-plugin-security": "^3.0.1"
  }
}
